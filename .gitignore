ml_probability_estimator.py
momentum_volatility_estimator.py

# Core modules wrongly matched by the throwaway-script rules above. These MUST
# stay tracked — without perpetual_futures_backtest.py the whole discovery +
# evolution pipeline fails to import on a fresh clone (the "suite can't collect"
# symptom), and fetch_binance_futures.py is the data-refresh utility.
!slate_core/discovery/perpetual_futures_backtest.py
!slate_core/discovery/fetch_binance_futures.py

# Report files
*_REPORT.md
*_ANALYSIS.md

# Data cache directories (optional - uncomment to ignore)
# btc_data_cache/
# sol_data_cache/

# PID files (runtime state)
*.pid

# Regime multi-stream data (fetched, not committed)
data/multi_stream/

# Bulky regenerable market-data caches (regenerate via fetch_*.py / fetch_basket.py /
# fetch_yield_pools.py / fetch_amm_pool_data.py). Keep code + results + small summaries.
sol_data_cache/BASKET_*.json
sol_data_cache/CEX_*_1d_ohlcv.json
sol_data_cache/AMM_*USDT_1d.json
sol_data_cache/yield_pools/*.json
# ...but keep the small curated pool-basket summary
!sol_data_cache/yield_pools/_basket_summary.json
